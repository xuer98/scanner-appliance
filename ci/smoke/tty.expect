#!/usr/bin/expect -f
# ci/smoke/tty.expect - drive the applianced console menu over the serial port.
#
#   expect -f ci/smoke/tty.expect <host> <port>
#
# Connects to the TCP socket QEMU exposes for the serial console, waits for
# the Status screen, opens Network (2) and Proxy (3), returns from each, sends
# an invalid choice and asserts that every screen renders. Menu numbering:
#   1 Status  2 Network  3 Proxy  4 Enroll  5 Support bundle  6 Wipe
# Network has "0) Back"; Proxy is a prompt that an empty line leaves.
#
# Every screen is matched on its header ("=== Scanner Appliance <version>
# — <Title> ===") and then read up to its prompt, so a pattern can never
# match text left over from the previous screen (the Status screen lists
# every menu title and "Proxy:" in its body). Patterns are case-exact:
# Expect 5.45 pre-filters -re patterns with a case-sensitive literal "gate"
# that ignores an inline (?i), so "(?i)proxy" never matched "Proxy".
#
# Exit status 0 on success, 1 on a timeout or an unexpected screen.

if {[llength $argv] != 2} {
    puts stderr "usage: tty.expect <host> <port>"
    exit 2
}
set host [lindex $argv 0]
set port [lindex $argv 1]

set timeout 120
log_user 1
match_max 100000

proc fail {msg} {
    puts stderr "\n\[tty.expect\] FAIL: $msg"
    exit 1
}

# Wait for a pattern; any timeout or EOF is fatal.
proc await {pattern what} {
    expect {
        -re $pattern {}
        timeout { fail "timed out waiting for $what" }
        eof     { fail "connection closed while waiting for $what" }
    }
}

# The Status screen, read up to its menu prompt.
proc await_status {what} {
    await {Status ===} "$what (header)"
    await {Select \[1-6\]: } "$what (menu prompt)"
}

if {[catch {set sock [socket $host $port]} err]} {
    fail "cannot connect to $host:$port: $err"
}
fconfigure $sock -translation binary -buffering none
spawn -open $sock

# Nudge the console: the menu redraws on input.
send "\r"
puts "\n\[tty.expect\] waiting for the Status screen"
await_status "Status screen"

# 2 -> Network, 0 -> back
puts "\n\[tty.expect\] opening Network"
send "2\r"
await {Network ===} "Network screen"
await {(wan0|lan0): (dhcp|static)} "Network screen contents"
await {0\) Back} "Network screen menu"
await {Select: } "Network screen prompt"
send "0\r"
await_status "Status screen after Network"

# 3 -> Proxy, an empty line -> back
puts "\n\[tty.expect\] opening Proxy"
send "3\r"
await {Proxy ===} "Proxy screen"
await {Current: } "Proxy screen contents"
await {host:port} "Proxy screen help"
await {Proxy: } "Proxy screen prompt"
send "\r"
await_status "Status screen after Proxy"

# An invalid choice must be rejected, not crash the menu.
puts "\n\[tty.expect\] sending an invalid choice"
send "9\r"
await {Unknown option} "input validation"
await {Press Enter to continue\.} "input validation pause"
send "\r"
await_status "Status screen after an invalid choice"

# Back on Status with the menu intact.
send "1\r"
await_status "Status screen"

puts "\n\[tty.expect\] PASS"
exit 0
