# Copy to docker/.env (git-ignored). Read by docker compose for variable
# substitution and passed to the appliance container as its env file.

# Image tag for the locally built images.
VERSION=dev
# 1 builds the appliance image with nmap (Phase 5 fingerprint pass, NPSL;
# only for builds made after the legal sign-off is recorded).
WITH_NMAP=0

# Bearer token for cp-api /admin/* endpoints.
CP_ADMIN_TOKEN=dev-admin-token
# Bearer token of the vendor-owner role (approves scope changes, attests the scope).
CP_OWNER_TOKEN=dev-owner-token

# Postgres password for the dev database.
POSTGRES_PASSWORD=cp

# Host ports for the control plane listeners.
CP_ENROLL_PORT=8443
CP_MTLS_PORT=9443

# Directory holding root.pem / intermediate.pem / intermediate-key.pem,
# relative to docker/. Created by `ci/build.sh --dev`.
PKI_DIR=../dev/pki

# --- appliance container -----------------------------------------------
# Enrollment code from POST /admin/appliances (see docs/DEPLOY.md).
APPLIANCE_CODE=
# Optional outbound proxy: host:port or user:pass@host:port
APPLIANCE_PROXY=
# Enrollment URL as seen from inside the compose network.
APPLIANCE_CP_URL=https://cp-api:8443
